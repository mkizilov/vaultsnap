# Configuration of the scheduled run (contrib/vaultsnap-scheduled.sh, docs/GUIDE.md).
# systemd reads this file as an EnvironmentFile; cron jobs load it with `set -a; . FILE; set +a`.
# Keep it readable by its owner only (mode 0600). It names the passphrase file but does not
# contain the passphrase.

# The repository: a directory, or s3://BUCKET[/FOLDER].
VAULTSNAP_REPO=/srv/backups/vaultsnap

# A file holding the passphrase, mode 0600, owned by the user the job runs as.
VAULTSNAP_PASSWORD_FILE=/etc/vaultsnap/passphrase

# Directories to back up, separated by colons.
VAULTSNAP_PATHS=/home:/etc:/var/lib

# Retention (docs/GUIDE.md). A rule that is set but empty is switched off; unset rules use the
# defaults shown. At least one rule must remain.
#VAULTSNAP_KEEP_LAST=
VAULTSNAP_KEEP_DAILY=7
VAULTSNAP_KEEP_WEEKLY=4
VAULTSNAP_KEEP_MONTHLY=12
#VAULTSNAP_KEEP_YEARLY=

# Read and decrypt all data on this weekday (1 is Monday); other days the check is the quick one.
VAULTSNAP_FULL_CHECK_DAY=7

# For a bucket (docs/S3.md), the usual AWS variables or a profile; the endpoint for an
# S3-compatible service. Nothing secret belongs in this file: use the AWS shared credentials
# file or an instance role.
#VAULTSNAP_S3_ENDPOINT=https://s3.example.org
#AWS_PROFILE=backup
